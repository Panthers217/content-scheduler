# MongoDB connection string
# Local development
MONGODB_URI=mongodb://localhost:27017/content_scheduler

# Production (MongoDB Atlas)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/content_scheduler?retryWrites=true&w=majority

# Firebase Admin SDK service account (JSON) path or the JSON content
FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json

# Port for backend (Render will set this automatically)
PORT=4000

# Environment
NODE_ENV=development
